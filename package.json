{
  "name": "age-of-empires-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "simulate": "vite build --ssr scripts/simulate.ts --outDir .sim --emptyOutDir --logLevel warn && node .sim/simulate.js",
    "real-map": "node scripts/real-map.mjs",
    "shots:movil": "node scripts/mobile-shots.mjs",
    "bench": "vite build --ssr scripts/bench.ts --outDir .sim --emptyOutDir --logLevel warn && node .sim/bench.js",
    "engines": "vite build --ssr scripts/engines.ts --outDir .sim --emptyOutDir --logLevel warn && node scripts/engines-compare.mjs",
    "lockstep": "vite build --ssr scripts/lockstep.ts --outDir .sim-lockstep --emptyOutDir --logLevel warn && node .sim-lockstep/lockstep.js",
    "test": "node -e \"require('fs').rmSync('node_modules/.vitest-cache',{recursive:true,force:true})\" && vitest run",
    "regions": "node scripts/regions.mjs",
    "world-map": "node scripts/world-map.mjs"
  },
  "devDependencies": {
    "geotiff": "^3.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
